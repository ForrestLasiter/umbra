#!/bin/sh
# NetworkManager dispatcher: re-assert the active umbra posture when a link comes
# up, so the MAC, hostname suppression, firewall and killswitch hold as you move
# between networks. Installed to /etc/NetworkManager/dispatcher.d/50-umbra
# (must be root-owned and not world-writable, or NetworkManager ignores it).
#
# $1 = interface, $2 = action ("up", "down", ...).
[ "$2" = "up" ] || exit 0

AP=/var/lib/umbra/active-profile
[ -f "$AP" ] || exit 0                    # no active posture -> nothing to do
PROFILE=$(cat "$AP" 2>/dev/null)
[ -n "$PROFILE" ] || exit 0

# Serialize with any other reapply (flock, held for the life of this script), so
# two transactions never run at once. Skip -- don't queue -- if one is running.
LOCK=/run/umbra-dispatch.lock
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK" || exit 0
  flock -n 9 || exit 0
fi

# Debounce: applying a profile can itself nudge NetworkManager (MAC/hostname
# reload), which re-fires this script. Skip if we ran in the last 15s.
TS=/run/umbra-dispatch.ts
now=$(date +%s 2>/dev/null || echo 0)
if [ -f "$TS" ]; then
  last=$(cat "$TS" 2>/dev/null || echo 0)
  [ $((now - last)) -lt 15 ] && exit 0
fi
echo "$now" > "$TS" 2>/dev/null || true

# apply is idempotent (acts only on drift), so this is cheap when nothing moved.
if /usr/bin/umbra --confirm apply "$PROFILE" >/dev/null 2>&1; then
  logger -t umbra-dispatch "reapplied posture '$PROFILE' on $1 up" 2>/dev/null || true
else
  rc=$?
  logger -t umbra-dispatch "FAILED to reapply '$PROFILE' on $1 up (rc=$rc)" 2>/dev/null \
    || echo "$(date) FAILED reapply '$PROFILE' on $1 (rc=$rc)" >> /var/log/umbra-dispatch.log 2>/dev/null \
    || true
fi
exit 0
