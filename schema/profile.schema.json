{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbra.local/schema/profile.schema.json",
  "title": "Umbra Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "modules"],
  "properties": {
    "apiVersion": { "const": "umbra/v1" },
    "kind": { "const": "Profile" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string" },
    "extends": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_mode": { "enum": ["closed", "open"], "default": "closed" },
        "require_confirm": { "type": "boolean", "default": false }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mac_randomization": { "enum": ["off", "per-network", "per-boot", "full"] },
            "suppress_probe_requests": { "type": "boolean" },
            "bluetooth": { "enum": ["on", "off", "non-discoverable"] },
            "radios": {
              "type": "array",
              "items": { "enum": ["wifi", "bluetooth", "wwan", "nfc"] },
              "uniqueItems": true
            }
          }
        },
        "netdark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "inbound_policy": { "enum": ["drop", "reject", "allow"] },
            "discovery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mdns": { "type": "boolean" },
                "llmnr": { "type": "boolean" },
                "netbios": { "type": "boolean" },
                "ssdp_upnp": { "type": "boolean" },
                "wsd": { "type": "boolean" }
              }
            },
            "ipv6_privacy": { "type": "boolean" },
            "block_listening_services": { "type": "boolean" }
          }
        },
        "tunnel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["off", "wireguard", "tor"] },
            "profile_ref": { "type": "string" },
            "killswitch": { "type": "boolean" },
            "dns": { "enum": ["tunnel", "doh", "dot"] },
            "leak_guard": {
              "type": "array",
              "items": { "enum": ["dns", "ipv6", "webrtc"] },
              "uniqueItems": true
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "blocklists": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "egress": { "enum": ["off", "blocklist", "allowlist"] },
            "disable_os_telemetry": { "type": "boolean" }
          }
        }
      }
    }
  }
}
