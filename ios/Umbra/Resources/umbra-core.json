  "profiles": {
    "home": {
      "description": "Sane hardening for a trusted LAN. Blocks telemetry and local discovery, raises a stealth firewall, and randomizes the MAC per network \u00e2\u20ac\u201d while staying usable (no killswitch, no radios off).\n",
      "fail_mode": "open",
      "requires": [
        "firewall",
        "ipv6_privacy",
        "discovery",
