{
  "umbra_spec_version": "1",
  "engine_version": "0.1.0",
  "enforcement_levels": [
    {
      "name": "enforced",
      "description": "Guaranteed with ordinary app permissions."
    },
    {
      "name": "requires_entitlement",
      "description": "Enforced after the OS grants a special entitlement (e.g. VPN consent, Network Extension)."
    },
    {
      "name": "requires_vpn_profile",
      "description": "Enforced only while an Umbra tunnel/VPN profile is active."
    },
    {
      "name": "requires_rooted_os",
      "description": "Only possible with root or a custom OS build."
    },
    {
      "name": "advisory",
      "description": "The app can measure and warn, but cannot change it."
    },
    {
      "name": "unavailable",
      "description": "Not applicable or impossible on this platform."
    }
  ],
  "capabilities": {
    "bluetooth_off": {
      "description": "Keep the Bluetooth radio off.",
      "controls": [
        "rf.radio_bluetooth"
      ]
    },
    "discovery": {
      "description": "Emit no local-network discovery chatter (mDNS/LLMNR/NetBIOS/SSDP/WSD).",
      "controls": [
        "netdark.mdns",
        "netdark.netbios",
        "netdark.llmnr",
        "netdark.ssdp_upnp",
        "netdark.wsd"
      ]
    },
    "firewall": {
      "description": "Do not be reachable from the local network (default-deny inbound).",
      "controls": [
        "netdark.inbound_policy"
      ]
    },
    "hostname": {
      "description": "Do not broadcast a stable hostname over DHCP.",
      "controls": [
        "identity.dhcp_hostname"
      ]
    },
    "ipv6_privacy": {
      "description": "Use rotating IPv6 privacy addresses, not a stable EUI-64.",
      "controls": [
        "netdark.ipv6_privacy"
      ]
    },
    "kernel": {
      "description": "Apply kernel hardening (restricted pointers/dmesg/ptrace, full ASLR).",
      "controls": [
        "kernel.sc_*"
      ]
    },
    "mac": {
      "description": "Randomize the Wi-Fi MAC so the hardware address is not a tracker.",
      "controls": [
        "rf.mac"
      ]
    },
    "telemetry": {
      "description": "Block OS/app phone-home and telemetry destinations.",
      "controls": [
        "telemetry.hosts_sinkhole"
      ]
    },
    "tor": {
      "description": "Route all traffic through Tor with an egress killswitch.",
      "controls": [
        "tunnel.tor_config",
        "tunnel.route",
        "tunnel.killswitch"
      ]
    },
    "webcam_off": {
      "description": "Disable the camera at the device level.",
      "controls": [
        "kernel.disable_webcam"
      ]
    },
    "wireguard": {
      "description": "Route all traffic through a WireGuard tunnel with an egress killswitch.",
      "controls": [
        "tunnel.route",
        "tunnel.killswitch"
      ]
    }
  },
  "platforms": {
    "linux": {
      "description": "Reference implementation. Enforces every control directly (nftables, systemd, sysctl, rfkill, Tor).",
      "capabilities": {
        "bluetooth_off": {
          "level": "enforced",
          "reason": "rfkill soft-block"
        },
        "discovery": {
          "level": "enforced",
          "reason": "stop/av mDNS/LLMNR/NetBIOS/SSDP/WSD daemons"
        },
        "firewall": {
          "level": "enforced",
          "reason": "nftables default-DROP inbound"
        },
        "hostname": {
          "level": "enforced",
          "reason": "NetworkManager dhcp-send-hostname=false"
        },
        "ipv6_privacy": {
          "level": "enforced",
          "reason": "sysctl use_tempaddr"
        },
        "kernel": {
          "level": "enforced",
          "reason": "hardening sysctls"
        },
        "mac": {
          "level": "enforced",
          "reason": "NetworkManager per-network MAC randomization"
        },
        "telemetry": {
          "level": "enforced",
          "reason": "/etc/hosts sinkhole + disable phone-home units"
        },
        "tor": {
          "level": "enforced",
          "reason": "nftables transparent-proxy redirect to Tor"
        },
        "webcam_off": {
          "level": "enforced",
          "reason": "unload the uvcvideo kernel module"
        },
        "wireguard": {
          "level": "enforced",
          "reason": "wg-quick + nftables killswitch"
        }
      }
    },
    "android": {
      "description": "VPNService-based. Real egress/DNS/tunnel control without root; kernel and system firewall need root.",
      "capabilities": {
        "bluetooth_off": {
          "level": "advisory",
          "reason": "Android 13+ blocks apps from toggling the radio; guide the user to the toggle"
        },
        "discovery": {
          "level": "advisory",
          "reason": "system owns mDNS/NSD; an app cannot silence it without root"
        },
        "firewall": {
          "level": "requires_rooted_os",
          "reason": "a system inbound firewall needs root; unrooted Android already sandboxes inbound per-app"
        },
        "hostname": {
          "level": "advisory",
          "reason": "modern Android randomizes the DHCP hostname itself; app can only verify"
        },
        "ipv6_privacy": {
          "level": "advisory",
          "reason": "Android enables IPv6 privacy addresses by default; not app-toggleable"
        },
        "kernel": {
          "level": "requires_rooted_os",
          "reason": "sysctl hardening requires root / a custom ROM"
        },
        "mac": {
          "level": "advisory",
          "reason": "Android 10+ randomizes MAC per-SSID by default; app verifies, cannot force"
        },
        "telemetry": {
          "level": "requires_vpn_profile",
          "reason": "sinkhole telemetry domains via a local VPNService DNS filter"
        },
        "tor": {
          "level": "requires_vpn_profile",
          "reason": "route all traffic through Tor via a VPNService packet tunnel"
        },
        "webcam_off": {
          "level": "advisory",
          "reason": "no module unload; guide to the OS camera kill-switch / permission revoke"
        },
        "wireguard": {
          "level": "requires_entitlement",
          "reason": "native WireGuard over VPNService after a one-time VPN-consent grant"
        }
      }
    },
    "android_system": {
      "description": "The Android app built into a custom Android OS as a privileged, platform-signed system app. Everything `android` can do, plus the system-only controls that build has wired up.",
      "capabilities": {
        "bluetooth_off": {
          "level": "enforced",
          "reason": "turns the Bluetooth radio off with the privileged adapter API"
        },
        "discovery": {
          "level": "enforced",
          "reason": "drops outbound mDNS/LLMNR/SSDP/NetBIOS/WS-Discovery packets in the OS packet filter"
        },
        "firewall": {
          "level": "enforced",
          "reason": "default-deny inbound packet filter, applied by the OS's umbra-net service and read back before it is reported"
        },
        "hostname": {
          "level": "enforced",
          "reason": "sets the Wi-Fi restriction that stops the device name being sent over DHCP, on open and secured networks"
        },
        "ipv6_privacy": {
          "level": "advisory",
          "reason": "Android enables IPv6 privacy addresses by default; not app-toggleable"
        },
        "kernel": {
          "level": "enforced",
          "reason": "asks init to assert the pointer/ASLR/core-dump sysctls and set perf_event_paranoid=3; that one is read back as proof, the rest are readable only by init"
        },
        "mac": {
          "level": "enforced",
          "reason": "forces a fresh random Wi-Fi MAC per connection on every network that randomizes (Android's default)"
        },
        "telemetry": {
          "level": "enforced",
          "reason": "the OS resolver answers blocklisted domains from a built-in hosts sinkhole, on any DNS transport and without the VPN slot"
        },
        "tor": {
          "level": "enforced",
          "reason": "pins Orbot (the Tor Project's app) as Android's always-on VPN with lockdown and no consent dialog, so traffic leaves through Tor or not at all; needs Orbot installed, which an OS image can ship for Umbra to install on first boot"
        },
        "webcam_off": {
          "level": "enforced",
          "reason": "sets the system 'no camera' user restriction, which blocks the camera for every app and survives a reboot"
        },
        "wireguard": {
          "level": "enforced",
          "reason": "brings the WireGuard tunnel up with no consent dialog and pins it as Android's always-on VPN with lockdown, so nothing leaves outside the tunnel"
        }
      }
    },
    "ios": {
      "description": "Network Extension-based. DNS and the tunnel via an entitlement; nearly everything else is advisory.",
      "capabilities": {
        "bluetooth_off": {
          "level": "advisory",
          "reason": "no programmatic radio toggle; guide the user to Control Center"
        },
        "discovery": {
          "level": "advisory",
          "reason": "system Bonjour is not app-controllable"
        },
        "firewall": {
          "level": "unavailable",
          "reason": "iOS exposes no app-level inbound firewall"
        },
        "hostname": {
          "level": "advisory",
          "reason": "iOS manages the DHCP hostname; app can only verify"
        },
        "ipv6_privacy": {
          "level": "advisory",
          "reason": "iOS uses private/temporary addresses by default; not app-toggleable"
        },
        "kernel": {
          "level": "unavailable",
          "reason": "no sysctl / kernel access in the app sandbox"
        },
        "mac": {
          "level": "advisory",
          "reason": "'Private Wi-Fi Address' is on per-network by default; not app-controllable"
        },
        "telemetry": {
          "level": "requires_entitlement",
          "reason": "block telemetry domains via a Network Extension DNS proxy / content filter"
        },
        "tor": {
          "level": "requires_vpn_profile",
          "reason": "route through Tor via a Packet Tunnel Provider"
        },
        "webcam_off": {
          "level": "unavailable",
          "reason": "camera is permission-gated only; no disable primitive"
        },
        "wireguard": {
          "level": "requires_entitlement",
          "reason": "WireGuard via NEVPNManager with the Network Extension entitlement"
        }
      }
    }
  },
