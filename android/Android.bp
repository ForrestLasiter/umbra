// Builds Umbra INSIDE an Android OS source tree (AOSP / LineageOS and friends),
// as an app signed with that OS's platform key. This is the `android_system`
// platform from the core spec.
//
// The normal app is built by Gradle (build.gradle.kts) and is unaffected by this
// file. Both builds compile the SAME sources; this one differs only in:
//   - certificate: "platform"  -> the OS grants the signature-level permissions
//     the system controls need (see app/.../system/SystemMode.kt);
//   - one swapped file: the WireGuard backend (see exclude_srcs below).
//
// To include it in an OS build: check this repository out anywhere in the tree
// (e.g. packages/apps/Umbra) and add `Umbra` to PRODUCT_PACKAGES.

// Gradle takes the package name from `namespace` in build.gradle.kts, so the
// source manifest has no package attribute. The platform build needs one, so add
// it here rather than keeping a second copy of the manifest that could drift.
genrule {
    name: "UmbraPlatformManifest",
    srcs: ["app/src/main/AndroidManifest.xml"],
    out: ["AndroidManifest.xml"],
    cmd: "sed 's/<manifest /<manifest package=\"com.forrestlasiter.umbra\" /' $(in) > $(out)",
}

// The OS half of the `firewall` and `discovery` capabilities: a small root
// service that applies packet-filter rules on the app's behalf. See
// os-integration/README.md for what an OS build must also add (SELinux policy).
sh_binary {
    name: "umbra-net",
    src: "os-integration/umbra-net.sh",
    filename: "umbra-net",
    init_rc: ["os-integration/umbra-net.rc"],
    vendor: true,
}

prebuilt_etc {
    name: "umbra-net-triggers.rc",
    src: "os-integration/umbra-net-triggers.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

// The hosts file the OS resolver reads while the telemetry sinkhole is on
// (generated from umbra/blocklists.py by scripts/sync-spec.sh). It only takes
// effect on an OS that also carries the resolver patch in os-integration/patches.
prebuilt_etc {
    name: "umbra-telemetry-hosts",
    src: "os-integration/telemetry.hosts",
    filename: "hosts",
    sub_dir: "umbra",
    system_ext_specific: true,
}

// The OS half of the `kernel` capability: init actions that apply the hardening
// sysctls on request. Only init may touch those on Android.
prebuilt_etc {
    name: "umbra-kernel.rc",
    src: "os-integration/umbra-kernel.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

android_app {
    name: "Umbra",
    required: [
        "umbra-kernel.rc",
        "umbra-net",
        "umbra-net-triggers.rc",
        "umbra-telemetry-hosts",
    ],
    manifest: ":UmbraPlatformManifest",

    // The Gradle build pulls the WireGuard userspace library from Maven. An OS
    // tree does not contain it, so there are two ways to build:
    //
    //   - by default, swap in platform/src/.../wg/WireGuardBackend.kt, a
    //     stand-in that reports "no tunnel in this OS build" instead of tunnelling;
    //   - if the OS provides the library as a module named
    //     `umbra-wireguard-tunnel` and sets the Soong config variable
    //     umbra.wireguard_tunnel to "true", build the real backend against it.
    //     See os-integration/README.md.
    srcs: ["app/src/main/java/**/*.kt"] + select(soong_config_variable("umbra", "wireguard_tunnel"), {
        "true": [],
        default: ["platform/src/**/*.kt"],
    }),
    exclude_srcs: select(soong_config_variable("umbra", "wireguard_tunnel"), {
        "true": [],
        default: ["app/src/main/java/com/forrestlasiter/umbra/wg/WireGuardBackend.kt"],
    }),

    resource_dirs: ["app/src/main/res"],
    asset_dirs: ["app/src/main/assets"],

    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "kotlinx-coroutines-android",
        "kotlinx_serialization_json",
    ] + select(soong_config_variable("umbra", "wireguard_tunnel"), {
        "true": ["umbra-wireguard-tunnel"],
        default: [],
    }),
    kotlin_plugins: ["kotlin-serialize-compiler-plugin"],

    // Public SDK only -- the same limit the Gradle build has. System-only calls
    // go through reflection (see system/Controls.kt), which is what lets one
    // source tree serve both builds.
    sdk_version: "current",
    min_sdk_version: "26",
    target_sdk_version: "34",

    // Platform-signed, but NOT privileged: every permission the controls use is
    // granted by signature alone, so the app does not need priv-app status or a
    // privileged-permission allowlist.
    certificate: "platform",
    system_ext_specific: true,

    optimize: {
        enabled: false,
    },
}
