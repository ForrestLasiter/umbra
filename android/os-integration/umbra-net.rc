# Defines umbra-net (see umbra-net.sh). When it runs is decided by
# umbra-net-triggers.rc, which has to live on the system side.
#
# NET_ADMIN and NET_RAW are the two capabilities iptables needs; the service has
# no others even though it runs as root. It is a vendor service because only
# vendor code may use Android's iptables wrapper (see umbra-net.sh).

service umbra-net /vendor/bin/umbra-net
    class main
    user root
    group root
    capabilities NET_ADMIN NET_RAW
    oneshot
    disabled
