# SELinux policy for umbra-net, the root service that applies Umbra's packet
# filter rules (see ../../umbra-net.sh).
#
# It is deliberately a VENDOR domain (no `coredomain`). Stock policy lets vendor
# domains run /system/bin/ip[6]tables-wrapper-1.0, which switches into the
# netutils_wrapper domain -- the only domain besides netd that may rewrite the
# filter table. That transition is already granted to every vendor domain, so
# nothing about iptables or BPF needs to be allowed here.

type umbra_net, domain;
type umbra_net_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(umbra_net)

# It is a shell script that calls getprop/setprop/sleep from /vendor/bin.
allow umbra_net vendor_shell_exec:file rx_file_perms;
allow umbra_net vendor_toolbox_exec:file rx_file_perms;

# Read what is wanted; report what was applied.
get_prop(umbra_net, umbra_net_prop)
set_prop(umbra_net, umbra_net_status_prop)
