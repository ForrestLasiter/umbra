<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The tunnel is how an unrooted phone enforces anything on the wire:
         telemetry sinkholing, WireGuard, and Tor all ride VPNService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read-only posture checks (advisory capabilities) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:label="Umbra"
        android:supportsRtl="true"
        android:theme="@style/Theme.Umbra">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The VPNService the OS binds when the user consents. BIND_VPN_SERVICE
             is granted to the system, not requested by us. -->
        <service
            android:name=".vpn.UmbraVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Routes device traffic through the selected Umbra privacy posture." />
        </service>

        <!-- The WireGuard userspace backend's own VpnService (libwg-go). Used for
             tunnel postures (travel/paranoid); one app-level VPN consent covers
             both this and UmbraVpnService. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="WireGuard tunnel for the selected Umbra posture." />
        </service>
    </application>
</manifest>
